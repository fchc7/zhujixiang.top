---
interface HeadingItem {
  id: string;
  text: string;
  depth: 2 | 3;
}

interface Props {
  items: HeadingItem[];
}

const { items } = Astro.props;
---

<nav id="table-of-contents" class="toc-shell hidden md:block" aria-label="文章目录">
  <ul class="toc-list">
    {
      items.map((item) => (
        <li>
          <a
            class="toc-item"
            href={`#${item.id}`}
            data-depth={item.depth}
            data-target={item.id}
          >
            <span class="toc-mark"></span>
            <span class="toc-text">{item.text}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .toc-shell {
    position: fixed;
    top: calc(var(--header-height) + 2.2rem);
    left: calc(50% + min(calc(var(--content-w) / 2), 50vw));
    margin-left: 1.7rem;
    z-index: 35;
    pointer-events: none;
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: auto;
  }

  .toc-item {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.32rem 0;
    color: var(--text-faint);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .toc-mark {
    display: block;
    width: 0.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
    transform: translateY(-0.22rem);
    transition:
      width 0.2s ease,
      opacity 0.2s ease;
  }

  .toc-text {
    max-width: 10rem;
    font-size: 0.68rem;
    line-height: 1.55;
    opacity: 0.68;
    transition: opacity 0.2s ease;
  }

  .toc-item[data-depth="3"] {
    margin-left: 0.65rem;
  }

  .toc-item[data-depth="3"] .toc-mark {
    width: 0.3rem;
    opacity: 0.3;
  }

  .toc-item:hover,
  .toc-item.active {
    color: var(--text);
  }

  .toc-item:hover .toc-mark,
  .toc-item.active .toc-mark {
    width: 0.8rem;
    opacity: 0.8;
  }

  .toc-item:hover .toc-text,
  .toc-item.active .toc-text {
    opacity: 1;
  }
</style>

<script>
  const tocItems = Array.from(document.querySelectorAll(".toc-item"));
  const headings = Array.from(document.querySelectorAll("h2[id], h3[id]"));

  tocItems.forEach((item) => {
    item.addEventListener("click", (event) => {
      const id = item.getAttribute("data-target");
      if (!id) return;

      const target = document.getElementById(id);
      if (!target) return;

      event.preventDefault();
      const top =
        window.scrollY +
        target.getBoundingClientRect().top -
        window.innerHeight * 0.22;
      window.scrollTo({ top, behavior: "smooth" });
    });
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.id;
        tocItems.forEach((item) => {
          item.classList.toggle(
            "active",
            entry.isIntersecting && item.getAttribute("data-target") === id
          );
        });
      });
    },
    {
      rootMargin: "-18% 0px -72% 0px",
      threshold: 0,
    }
  );

  headings.forEach((heading) => observer.observe(heading));
</script>
