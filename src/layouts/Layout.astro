---
import "../styles/global.css";

const pathname =
  Astro.url?.pathname ??
  (Astro.request?.url ? new URL(Astro.request.url).pathname : "/");

const navItems: Array<{ href: string; label: string }> = [
  { href: "/", label: "writing" },
  { href: "/about", label: "about" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/" || pathname.startsWith("/articles");
  return pathname === href || pathname.startsWith(`${href}/`);
};

const showBeian = pathname === "/" || pathname.startsWith("/articles");
const beianNo = "鄂ICP备2022002592号-2";
---

<!doctype html>
<html lang="zh-CN" id="html">
  <head>
    <script is:inline>
      (function () {
        try {
          var storedTheme = localStorage.getItem("theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          var isDark = storedTheme === "dark" || (!storedTheme && prefersDark);

          document.documentElement.classList.toggle("dark", isDark);
        } catch (error) {
          // Ignore storage access issues.
        }
      })();
    </script>
    <style is:inline>
      html.dark {
        color-scheme: dark;
      }

      html,
      body {
        margin: 0;
        width: 100%;
        min-height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
      }
    </style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Zhu Jixiang's Blog</title>
  </head>
  <body class="page-shell">
    <div
      id="scroll-sentinel"
      class="absolute top-0 left-0 w-full"
      style="height: var(--header-height); pointer-events: none;"
    ></div>

    <header
      id="main-header"
      class="site-header fixed inset-x-0 top-0 z-40 border-b border-transparent"
    >
      <div class="grid w-full grid-cols-[minmax(0,0fr)_minmax(0,var(--content-w))_minmax(0,0fr)] px-4 md:grid-cols-[1fr_minmax(0,var(--content-w))_1fr] md:px-0">
        <div></div>
        <nav class="site-nav min-w-0">
          <a href="/" class="brand-mark" aria-label="首页">
            <span class="brand-name">zhu jixiang</span>
            <span class="brand-subtitle">notes / fragments / essays</span>
          </a>

          <div class="nav-actions">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class={`nav-link ${isActive(item.href) ? "is-active" : ""}`}
                >
                  {item.label}
                </a>
              ))
            }

            <button
              id="theme-toggle"
              class="theme-toggle"
              aria-label="切换明暗模式"
            >
              <svg
                id="sun-icon"
                class="hidden h-[1.05rem] w-[1.05rem] dark:block"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.6"
                  d="M12 3v1.25m0 15.5V21m9-9h-1.25M4.25 12H3m14.22 6.72-.88-.88M7.91 7.91l-.88-.88m11.08 0-.88.88M7.91 16.09l-.88.88M15.5 12a3.5 3.5 0 11-7 0 3.5 3.5 0 017 0z"
                ></path>
              </svg>
              <svg
                id="moon-icon"
                class="block h-[1.05rem] w-[1.05rem] dark:hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.6"
                  d="M20.2 15.1A8.8 8.8 0 018.9 3.8a9.3 9.3 0 1011.3 11.3z"
                ></path>
              </svg>
            </button>
          </div>
        </nav>
        <div></div>
      </div>
      <div id="scroll-progress" class="scroll-progress"></div>
    </header>

    <main class="site-main" style="padding-top: var(--header-height);">
      <div class="grid w-full grid-cols-[minmax(0,0fr)_minmax(0,var(--content-w))_minmax(0,0fr)] px-4 md:grid-cols-[1fr_minmax(0,var(--content-w))_1fr] md:px-0">
        <div></div>
        <div class="min-w-0 px-0 pb-16 pt-3 md:pr-14">
          <slot />
        </div>
        <div></div>
      </div>
    </main>

    <div
      class="pointer-events-none fixed left-[calc(50%+min(calc(var(--content-w)/2),50vw))] top-0 z-30 hidden h-full w-px bg-[var(--line)] transition-colors md:block"
    ></div>

    <button id="back-to-top" class="back-to-top" aria-label="回到顶部">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.8"
          d="M6 14l6-6 6 6"
        ></path>
      </svg>
    </button>

    {
      showBeian && (
        <footer
          class="beian-footer grid grid-cols-[minmax(0,0fr)_minmax(0,var(--content-w))_minmax(0,0fr)] px-4 md:grid-cols-[1fr_minmax(0,var(--content-w))_1fr] md:px-0"
          role="contentinfo"
        >
          <div></div>
          <div class="min-w-0 pb-8 pt-10 md:pr-14">
            <div class="section-rule"></div>
            <a
              href="https://beian.miit.gov.cn/"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-block text-[0.68rem] tracking-[0.18em] text-[var(--text-faint)] transition-colors hover:text-[var(--brand)]"
            >
              {beianNo}
            </a>
          </div>
          <div></div>
        </footer>
      )
    }

    <script>
      const themeToggle = document.getElementById("theme-toggle");
      const backToTop = document.getElementById("back-to-top");
      const header = document.getElementById("main-header");
      const sentinel = document.getElementById("scroll-sentinel");
      const progressBar = document.getElementById("scroll-progress");
      const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const isArticleDetail =
        window.location.pathname.startsWith("/articles/") &&
        window.location.pathname !== "/articles" &&
        window.location.pathname !== "/articles/";

      themeToggle?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch (error) {
          // Ignore storage access issues.
        }
      });

      mediaQuery.addEventListener("change", (event) => {
        try {
          if (localStorage.getItem("theme")) return;
        } catch (error) {
          // Ignore storage access issues.
        }

        document.documentElement.classList.toggle("dark", event.matches);
      });

      backToTop?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      if (header && sentinel) {
        const updateScrollEffects = () => {
          const winScroll = window.scrollY;
          const maxScroll =
            document.documentElement.scrollHeight - window.innerHeight;
          const scrolled = maxScroll > 0 ? winScroll / maxScroll : 0;

          if (progressBar) {
            progressBar.style.transform = isArticleDetail
              ? `scaleX(${scrolled})`
              : "scaleX(0)";
            progressBar.style.opacity = isArticleDetail ? "1" : "0";
          }
        };

        let ticking = false;

        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(() => {
              updateScrollEffects();
              ticking = false;
            });
          },
          { passive: true }
        );

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              document.body.classList.toggle("header-shrunk", !entry.isIntersecting);
            });
          },
          { threshold: 0 }
        );

        observer.observe(sentinel);
        updateScrollEffects();
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    height: var(--header-height);
    transition:
      height 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.2s ease,
      background-color 0.2s ease,
      backdrop-filter 0.2s ease;
  }

  .site-main {
    flex: 1 0 auto;
  }

  .site-nav {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    padding: 1.5rem 0 1.15rem;
    transition: padding 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .brand-mark {
    display: inline-flex;
    flex-direction: column;
    gap: 0.32rem;
    min-width: 0;
    text-decoration: none;
  }

  .brand-name {
    color: var(--text);
    font-size: 0.92rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .brand-subtitle {
    color: var(--text-faint);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-link {
    position: relative;
    color: var(--text-muted);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.35rem;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .theme-toggle,
  .back-to-top {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .theme-toggle {
    margin-right: 0.45rem;
  }

  .theme-toggle:hover,
  .back-to-top:hover {
    color: var(--text);
    border-color: var(--line);
    background: var(--bg-elevated);
    transform: translateY(-1px);
  }

  .scroll-progress {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 1px;
    width: 100%;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .back-to-top {
    position: fixed;
    bottom: 1.75rem;
    left: calc(50% + min(calc(var(--content-w) / 2), 50vw));
    margin-left: 0.95rem;
    z-index: 45;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.75rem);
  }

  .beian-footer {
    margin-top: auto;
  }

  :global(body.header-shrunk) .site-header {
    height: var(--header-height-shrunk);
    border-color: var(--line);
    background: color-mix(in srgb, var(--bg-strong) 92%, transparent);
    backdrop-filter: blur(18px);
  }

  :global(body.header-shrunk) .site-nav {
    align-items: center;
    padding: 0.85rem 0;
  }

  :global(body.header-shrunk) .back-to-top {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  @media (max-width: 767px) {
    .site-nav {
      align-items: center;
      padding: 1rem 0 0.9rem;
    }

    .brand-subtitle {
      display: none;
    }

    .brand-name {
      font-size: 0.86rem;
    }

    .nav-actions {
      gap: 0.75rem;
    }

    .theme-toggle {
      margin-right: 0;
    }

    .nav-link {
      font-size: 0.72rem;
      letter-spacing: 0.14em;
    }

    .back-to-top {
      display: none;
    }
  }
</style>
