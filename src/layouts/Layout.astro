---
import "../styles/global.css";

const pathname =
  Astro.url?.pathname ??
  (Astro.request?.url ? new URL(Astro.request.url).pathname : "/");

const navItems: Array<{ href: string; label: string }> = [
  { href: "/", label: "Articles" },
  { href: "/about", label: "About" },
];

const isActive = (href: string) => {
  // 首页就是 Articles；同时把 /articles 也视为 Articles（配合重定向/兼容旧链接）
  if (href === "/") return pathname === "/" || pathname.startsWith("/articles");
  return pathname === href || pathname.startsWith(`${href}/`);
};

const splitLastN = (label: string, n = 3) => {
  const chars = Array.from(label);
  if (chars.length <= n) return { prefix: "", suffix: label };
  return {
    prefix: chars.slice(0, -n).join(""),
    suffix: chars.slice(-n).join(""),
  };
};
---

<!doctype html>
<html lang="zh-CN" id="html">
  <head>
    <script is:inline>
      // 必须在任何内容渲染前执行，防止 FOUC
      (function() {
        try {
          const theme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (theme === 'dark' || (!theme && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          // localStorage 可能不可用，忽略错误
        }
      })();
    </script>
    <style is:inline>
      /* 防止 FOUC：立即应用暗色模式样式 */
      html.dark {
        color-scheme: dark;
      }
      html.dark body {
        background-color: #0f172a !important; /* slate-900 */
      }
      html.dark header {
        background-color: #0f172a !important; /* slate-900 */
        border-bottom-color: #1e293b !important; /* slate-800 */
      }
    </style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
    <style>
      /* 初始状态和缩放状态的样式 */
      header#main-header {
        height: 8rem; /* h-32 = 128px */
        transition: height 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                    background-color 0.3s, 
                    border-color 0.3s;
      }

      header#main-header nav {
        transition: padding 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* 北极星容器样式 */
      #polaris-container {
        top: 8rem; /* 初始位置 128px */
        transition: top 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* 缩放状态下的样式变化 */
      .header-shrunk header#main-header {
        height: 56px;
      }

      .header-shrunk #polaris-container {
        top: 56px;
      }

      /* 缩放时调整内部导航的内边距，实现视觉上的居中 */
      .header-shrunk header#main-header nav {
        padding-top: 0;
        padding-bottom: 0;
      }
    </style>
  </head>
  <body class="bg-white dark:bg-slate-900 transition-colors">
    <!-- 哨兵元素：用于监听滚动位置 -->
    <div id="scroll-sentinel" class="absolute top-0 left-0 w-full h-32 pointer-events-none"></div>

    <header
      id="main-header"
      class="flex fixed top-0 left-0 z-40 w-full bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 transition-colors"
    >
      <div
        class="w-full h-full grid grid-cols-[minmax(0,0fr)_minmax(0,var(--content-w))_minmax(0,0fr)] md:grid-cols-[1fr_minmax(0,var(--content-w))_1fr] px-4 md:px-0"
      >
        <div></div>
        <nav class="min-w-0 flex items-end gap-4 md:gap-8 p-4 pr-12">
          {
            navItems.map((item) => {
              const active = isActive(item.href);
              const showTagMark =
                pathname.startsWith("/tags") && item.href === "/";
              const { prefix, suffix } = splitLastN(item.label, 3);
              return (
                <a
                  href={item.href}
                  class="inline-flex items-baseline text-base font-bold text-slate-900 dark:text-slate-100"
                >
                  {prefix}
                  <span class={`relative ${active ? "text-(--brand)" : ""}`}>
                    {suffix}
                    {showTagMark && (
                      <span
                        class="absolute top-0 -right-3 text-(--brand) text-sm leading-none"
                        aria-hidden="true"
                      >
                        #
                      </span>
                    )}
                  </span>
                </a>
              );
            })
          }
          <button
            id="theme-toggle"
            class="ml-auto p-2 rounded-md text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            aria-label="切换主题"
          >
            <svg
              id="sun-icon"
              class="w-5 h-5 hidden dark:block"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              />
            </svg>
            <svg
              id="moon-icon"
              class="w-5 h-5 block dark:hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              />
            </svg>
          </button>
        </nav>
        <div></div>
      </div>
    </header>
    <main class="w-full h-full pt-32">
      <div
        class="w-full h-full grid grid-cols-[minmax(0,0fr)_minmax(0,var(--content-w))_minmax(0,0fr)] md:grid-cols-[1fr_minmax(0,var(--content-w))_1fr] px-4 md:px-0"
      >
        <div></div>
        <div class="min-w-0 p-4 md:pr-12">
          <slot />
        </div>
        <div></div>
      </div>
    </main>

    <!-- 右侧分割线（平板及以上屏幕显示） -->
    <div
      class="hidden md:block fixed top-0 left-[calc(50%+min(calc(var(--content-w)/2),50vw))] z-50 h-full w-px bg-slate-200 dark:bg-slate-800 pointer-events-none transition-colors"
    >
      <!-- 交点四角星（类似北极星） -->
      <div
        id="polaris-container"
        class="absolute left-0 -translate-x-1/2 -translate-y-1/2 z-50"
      >
        <svg
          viewBox="-0.2 0 24 24"
          class="h-5 w-5 text-slate-200 dark:text-slate-700"
          aria-hidden="true"
        >
          <path
            d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z"
            fill="white"
            class="dark:fill-slate-800"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
      </div>
    </div>

    <script>
      // 主题切换逻辑
      const themeToggle = document.getElementById("theme-toggle");
      themeToggle?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });

      // Header 缩放逻辑 (仅在文章详情页生效)
      const header = document.getElementById("main-header");
      const sentinel = document.getElementById("scroll-sentinel");
      
      // 判断是否为文章详情页 (以 /articles/ 开头且不是列表页)
      const path = window.location.pathname;
      const isArticleDetail = path.startsWith('/articles/') && path !== '/articles' && path !== '/articles/';

      if (header && sentinel && isArticleDetail) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            // 当哨兵元素完全离开视口时（即滚动超过 128px），在 body 上切换类名
            if (!entry.isIntersecting) {
              document.body.classList.add("header-shrunk");
            } else {
              document.body.classList.remove("header-shrunk");
            }
          });
        }, {
          threshold: 0,
        });

        observer.observe(sentinel);
      }
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
