---
import {
  siElectron,
  siGithub,
  siNodedotjs,
  siReact,
  siRust,
  siSwift,
  siTypescript,
  siVuedotjs,
} from "simple-icons";
import Layout from "../layouts/Layout.astro";

const techStack = [
  { name: "TypeScript", icon: siTypescript },
  { name: "Rust", icon: siRust },
  { name: "React", icon: siReact },
  { name: "Vue", icon: siVuedotjs },
  { name: "Node.js", icon: siNodedotjs },
  { name: "Electron", icon: siElectron },
  { name: "Swift", icon: siSwift },
];

const interests = [
  "关注简洁、耐久、可长期维护的产品体验。",
  "喜欢把复杂的交互与系统问题做得更轻、更快、更顺手。",
  "持续记录 AI、开发工具与个人工作流之间的交汇处。",
];
---

<Layout>
  <section class="about-hero">
    <div class="about-head">
      <img src="/avatar.jpeg" alt="Zhu Jixiang" class="about-avatar" />

      <div class="about-copy">
        <p class="eyebrow">about the author</p>
        <div class="about-name-row">
          <h1 class="about-name">fchc7 / Zhu Jixiang</h1>
          <a
            href="https://github.com/fchc7"
            target="_blank"
            rel="noopener noreferrer"
            class="about-link"
            aria-label="GitHub"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d={siGithub.path}></path>
            </svg>
          </a>
        </div>
        <p class="about-intro">
          一名全栈开发者，也在意文字、节奏和界面的呼吸感。这个站点像一份私人索引，
          记录写作、代码、工具，以及偶尔慢下来的时刻。
        </p>
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="section-rule"></div>
    <div class="about-grid">
      <section class="about-column">
        <p class="eyebrow">focus</p>
        <ul class="about-list">
          {interests.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="about-column">
        <p class="eyebrow">stack</p>
        <div class="stack-list">
          {techStack.map((tech) => (
            <span class="stack-item">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={tech.icon.path}></path>
              </svg>
              <span>{tech.name}</span>
            </span>
          ))}
        </div>
      </section>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    padding: 2.4rem 0 3.4rem;
  }

  .about-head {
    display: grid;
    gap: 1.8rem;
    align-items: start;
  }

  .about-avatar {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 1.5rem;
    object-fit: cover;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
  }

  .about-copy {
    min-width: 0;
  }

  .about-name-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.95rem;
  }

  .about-name {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.8rem, 1.3rem + 2vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .about-link {
    color: var(--text-faint);
    transition: color 0.2s ease;
  }

  .about-link:hover {
    color: var(--brand);
  }

  .about-intro {
    max-width: 37rem;
    margin: 1.45rem 0 0;
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 2.05;
  }

  .about-section {
    padding-bottom: 3rem;
  }

  .about-grid {
    display: grid;
    gap: 2.8rem;
    padding-top: 2.2rem;
  }

  .about-column {
    min-width: 0;
  }

  .about-list {
    max-width: 28rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 2;
  }

  .about-list li + li {
    margin-top: 1rem;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.2rem;
    margin-top: 1.25rem;
    max-width: 24rem;
  }

  .stack-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .about-head {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2.2rem;
    }

    .about-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: 4.25rem;
      padding-top: 2.6rem;
    }
  }
</style>
