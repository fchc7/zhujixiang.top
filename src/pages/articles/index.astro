---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout>
  <section class="w-full">
    <div class="divide-y divide-slate-200">
      {
        posts.map((post) => (
          <article class="py-8">
            <div class="text-xs text-slate-500">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("zh-CN", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <span class="mx-2">by</span>
              <span>{post.data.author}</span>
            </div>

            <h2 class="mt-2 text-xl font-semibold tracking-tight text-slate-900">
              <a href={`/articles/${post.slug}`} class="hover:text-(--brand)">
                {post.data.title}
              </a>
            </h2>

            <p class="mt-2 text-sm leading-6 text-slate-600">
              {post.data.excerpt}
            </p>

            <div class="mt-4 flex flex-wrap gap-x-3 gap-y-2 text-xs text-slate-500">
              {post.data.tags.map((tag) => (
                <a
                  href={`/tags/${encodeURIComponent(tag)}`}
                  class="hover:text-(--brand)"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
