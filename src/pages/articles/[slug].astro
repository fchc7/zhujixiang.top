---
import { getCollection } from "astro:content";
import type { Heading, Root } from "mdast";
import { remark } from "remark";
import { visit } from "unist-util-visit";
import TableOfContents from "../../components/TableOfContents.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const headings: Array<{ id: string; text: string; depth: 2 | 3 }> = [];

const headingPlugin = () => {
  return (tree: Root) => {
    visit(tree, "heading", (node) => {
      const heading = node as Heading;
      if (heading.depth !== 2 && heading.depth !== 3) return;

      const text = heading.children
        .map((child) => ("value" in child ? child.value : ""))
        .join("")
        .trim();

      if (!text) return;

      const id = text
        .toLowerCase()
        .replace(/[^\w\u4e00-\u9fa5\s-]/g, "")
        .replace(/\s+/g, "-");

      headings.push({ id, text, depth: heading.depth as 2 | 3 });
    });
  };
};

const tree = remark().parse(post.body);
await remark().use(headingPlugin).run(tree);

const publishDate = post.data.date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<Layout>
  <article class="article-shell">
    <header class="article-header prose-shell">
      <p class="eyebrow">essay</p>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-excerpt">{post.data.excerpt}</p>

      <div class="article-meta">
        <span>{publishDate}</span>
        <span class="article-meta-dot"></span>
        <span>{post.data.author}</span>
      </div>

      <div class="article-tags">
        {post.data.tags.map((tag) => (
          <a href={`/tags?tag=${encodeURIComponent(tag)}`} class="article-tag">
            #{tag}
          </a>
        ))}
      </div>
    </header>

    <div class="article-body md-content">
      <Content />
    </div>
  </article>

  {headings.length > 0 && <TableOfContents items={headings} />}
</Layout>

<style>
  .article-shell {
    padding: 1.6rem 0 2rem;
  }

  .article-header {
    padding-bottom: 2.2rem;
    border-bottom: 1px solid var(--line);
  }

  .article-title {
    margin: 0.85rem 0 0;
    color: var(--text);
    font-size: clamp(2rem, 1.45rem + 2.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.035em;
  }

  .article-excerpt {
    max-width: 36rem;
    margin: 1.2rem 0 0;
    color: var(--text-muted);
    font-size: 0.96rem;
    line-height: 1.95;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.5rem;
    color: var(--text-faint);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .article-meta-dot {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.5;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .article-tag {
    color: var(--brand);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }

  .article-tag:hover {
    opacity: 0.72;
  }

  .article-body {
    padding-top: 2.2rem;
  }

  @media (max-width: 767px) {
    .article-shell {
      padding-top: 1rem;
    }

    .article-excerpt {
      font-size: 0.91rem;
    }

    .article-meta {
      flex-wrap: wrap;
      gap: 0.5rem 0.7rem;
    }
  }
</style>
