---
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags))
).sort((a, b) => a.localeCompare(b, "zh-CN"));
---

<Layout>
  <section class="tags-intro" data-tags-page>
    <p class="eyebrow">tag view</p>
    <h1 class="tags-title">从标签进入。</h1>
    <p class="tags-copy">
      有些文章彼此关联，但不必强行归档。标签更像细线，把零散的记录轻轻串起来。
    </p>

    <div class="tag-cloud" data-tags-list>
      <a href="/tags" class="tag-filter is-selected" data-tag-option="">
        all
      </a>
      {
        allTags.map((tag) => (
          <a
            href={`/tags?tag=${encodeURIComponent(tag)}`}
            class="tag-filter"
            data-tag-option={tag}
          >
            {tag}
          </a>
        ))
      }
    </div>
  </section>

  <section class="tags-results">
    <div class="section-rule"></div>
    <div class="post-list" data-posts-list>
      {posts.map((post) => (
        <div data-post-tags={JSON.stringify(post.data.tags)}>
          <PostCard
            slug={post.slug}
            title={post.data.title}
            date={post.data.date}
            author={post.data.author}
            excerpt={post.data.excerpt}
            tags={post.data.tags}
          />
        </div>
      ))}
      <p class="empty-state hidden" data-empty-msg>
        当前标签下还没有文章。
      </p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const page = document.querySelector("[data-tags-page]");
      const list = document.querySelector("[data-posts-list]");
      if (!page || !list) return;

      const tagOptions = page.querySelectorAll("[data-tag-option]");
      const postWrappers = list.querySelectorAll("[data-post-tags]");
      const emptyState = list.querySelector("[data-empty-msg]");

      const applyFilter = () => {
        const url = new URL(window.location.href);
        const selectedTag = url.searchParams.get("tag");
        let visibleCount = 0;

        tagOptions.forEach((option) => {
          const optionTag = option.getAttribute("data-tag-option");
          const isSelected = (optionTag || null) === (selectedTag || null);
          option.classList.toggle("is-selected", isSelected);
          option.setAttribute(
            "href",
            optionTag ? `/tags?tag=${encodeURIComponent(optionTag)}` : "/tags"
          );
        });

        postWrappers.forEach((wrapper) => {
          const tags = JSON.parse(wrapper.getAttribute("data-post-tags") || "[]");
          const shouldShow = !selectedTag || tags.includes(selectedTag);
          wrapper.classList.toggle("hidden", !shouldShow);
          visibleCount += shouldShow ? 1 : 0;

          const tagLinks = wrapper.querySelectorAll(".post-tag");
          tagLinks.forEach((tagLink) => {
            const isActive = tagLink.textContent === `#${selectedTag ?? ""}`;
            tagLink.classList.toggle("is-selected", isActive);
          });
        });

        emptyState?.classList.toggle("hidden", visibleCount > 0);
      };

      applyFilter();
      window.addEventListener("popstate", applyFilter);
    })();
  </script>
</Layout>

<style>
  .tags-intro {
    padding: 1.8rem 0 2.4rem;
  }

  .tags-title {
    margin: 0.75rem 0 0;
    color: var(--text);
    font-size: clamp(1.9rem, 1.4rem + 2vw, 3rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .tags-copy {
    max-width: 34rem;
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.9;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    margin-top: 1.7rem;
  }

  .tag-filter {
    color: var(--text-faint);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .tag-filter:hover,
  .tag-filter.is-selected {
    color: var(--brand);
  }

  .tags-results {
    padding-bottom: 2rem;
  }

  .post-list {
    margin-top: 0.65rem;
  }

  .empty-state {
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
</style>
