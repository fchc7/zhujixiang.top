---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

type Props = {
  tag: string;
  posts: Awaited<ReturnType<typeof getCollection<"posts">>>;
};

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const map = new Map<string, typeof posts>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const arr = map.get(tag) ?? [];
      arr.push(post);
      map.set(tag, arr);
    }
  }

  return Array.from(map.entries()).map(([tag, taggedPosts]) => ({
    // 注意：这里不要 encodeURIComponent，否则 Astro 可能再做一次编码导致路径不匹配（例如 %20 变成 %2520）
    params: { tag },
    props: {
      tag,
      posts: taggedPosts.sort(
        (a, b) => b.data.date.getTime() - a.data.date.getTime()
      ),
    } satisfies Props,
  }));
}

const { tag, posts } = Astro.props as Props;
---

<Layout>
  <section class="w-full">
    <div class="pb-6 border-b border-slate-200">
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">
        #{tag}
      </h1>
      <p class="mt-2 text-sm text-slate-600">共 {posts.length} 篇文章</p>
    </div>

    <div class="divide-y divide-slate-200">
      {
        posts.map((post) => (
          <article class="py-8">
            <div class="text-xs text-slate-500">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("zh-CN", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <span class="mx-2">by</span>
              <span>{post.data.author}</span>
            </div>

            <h2 class="mt-2 text-xl font-semibold tracking-tight text-slate-900">
              <a href={`/articles/${post.slug}`} class="hover:text-(--brand)">
                {post.data.title}
              </a>
            </h2>

            <p class="mt-2 text-sm leading-6 text-slate-600">
              {post.data.excerpt}
            </p>

            <div class="mt-4 flex flex-wrap gap-x-3 gap-y-2 text-xs text-slate-500">
              {post.data.tags.map((t) => (
                <a
                  href={`/tags/${encodeURIComponent(t)}`}
                  class={t === tag ? "text-(--brand)" : "hover:text-(--brand)"}
                >
                  #{t}
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
